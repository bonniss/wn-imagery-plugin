<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <!--
            Unit runs anywhere: no Winter checkout, no database, no app. It is
            where the branching logic lives, so it is what CI runs. Behaviour
            inside Winter is checked by installing into a Winter app; see the
            README's "For developers".
        -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
