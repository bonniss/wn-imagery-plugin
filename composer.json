{
    "name": "bonniss26/wn-imagery-plugin",
    "type": "winter-plugin",
    "description": "LQIP image placeholders for Winter CMS - Twig filters, database caching, settings, console commands and queued generation, on GD or Imagick.",
    "homepage": "https://github.com/bonniss/wn-imagery-plugin",
    "keywords": ["wintercms", "winter", "lqip", "placeholder", "images", "performance", "twig"],
    "license": "MIT",
    "authors": [
        {
            "name": "bonniss26"
        }
    ],
    "require": {
        "php": "^8.0.2",
        "composer/installers": "~1.11 || ^2.0",
        "bonniss26/lqip": "^0.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../lqip",
            "options": {
                "symlink": true,
                "versions": {
                    "bonniss26/lqip": "0.3.0"
                }
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Bonniss26\\Imagery\\Classes\\": "classes/",
            "Bonniss26\\Imagery\\Models\\": "models/",
            "Bonniss26\\Imagery\\Traits\\": "traits/",
            "Bonniss26\\Imagery\\Facades\\": "facades/",
            "Bonniss26\\Imagery\\Jobs\\": "jobs/",
            "Bonniss26\\Imagery\\Console\\": "console/",
            "Bonniss26\\Imagery\\Tests\\": "tests/"
        }
    },
    "extra": {
        "installer-name": "imagery"
    },
    "scripts": {
        "test": "phpunit --testsuite=Unit"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
